generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Note: DATABASE_URL is read from backend/.env
// Format: postgres://user:password@host:port/database

// ==================== EXISTING TABLES ====================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique
  password  String
  role      String   @default("viewer")
  mfaEnabled Boolean  @default(false) @map("mfa_enabled")
  mfaSecret  String?  @map("mfa_secret")
  mfaTempSecret String? @map("mfa_temp_secret")
  mfaRequired Boolean @default(false) @map("mfa_required")
  createdAt DateTime @default(now()) @map("created_at")

  aiConversations AiConversation[]
  aiProfile       AiUserProfile?

  @@map("users")
}

// ==================== NGINX VISUAL MANAGER ====================

model NginxServer {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(255)
  primaryDomain        String    @unique @map("primary_domain") @db.VarChar(255)
  additionalDomains    String[]  @default([]) @map("additional_domains")
  upstreamServers      Json      @default("[]") @map("upstream_servers")
  pathRules            Json      @default("[]") @map("path_rules")
  serverType           String    @default("proxy") @map("server_type") @db.VarChar(50)
  listenPort           Int       @default(80) @map("listen_port")
  sslType              String    @default("none") @map("ssl_type") @db.VarChar(50)
  sslCertPath          String?   @map("ssl_cert_path") @db.VarChar(500)
  sslKeyPath           String?   @map("ssl_key_path") @db.VarChar(500)
  proxyHost            String    @default("localhost") @map("proxy_host") @db.VarChar(255)
  proxyPort            Int       @default(3000) @map("proxy_port")
  rootPath             String    @default("/var/www/html") @map("root_path") @db.VarChar(500)
  websocketEnabled     Boolean   @default(true) @map("websocket_enabled")
  forwardHeaders       Boolean   @default(true) @map("forward_headers")
  clientMaxBodySize    String    @default("50m") @map("client_max_body_size") @db.VarChar(20)
  proxyConnectTimeout  String    @default("5s") @map("proxy_connect_timeout") @db.VarChar(20)
  proxyReadTimeout     String    @default("60s") @map("proxy_read_timeout") @db.VarChar(20)
  proxySendTimeout     String    @default("60s") @map("proxy_send_timeout") @db.VarChar(20)
  securityHeadersEnabled Boolean @default(false) @map("security_headers_enabled")
  serverTokensOff     Boolean   @default(true) @map("server_tokens_off")
  tlsMinVersionEnforced Boolean @default(true) @map("tls_min_version_enforced")
  isActive             Boolean   @default(true) @map("is_active")
  configFilePath       String?   @map("config_file_path") @db.VarChar(500)
  dockerMeta           Json      @default("{}") @map("docker_meta")
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  logs     NginxLog[]
  sslCerts NginxSslCert[]

  @@map("nginx_servers")
}

model NginxLog {
  id             Int       @id @default(autoincrement())
  serverId       Int?      @map("server_id")
  clientIp       String?   @map("client_ip") @db.VarChar(45)
  requestMethod  String?   @map("request_method") @db.VarChar(10)
  requestPath    String?   @map("request_path") @db.Text
  statusCode     Int?      @map("status_code")
  responseTimeMs Int?      @map("response_time_ms")
  bytesSent      Int?      @map("bytes_sent")
  userAgent      String?   @map("user_agent") @db.Text
  referer        String?   @db.Text
  timestamp      DateTime  @default(now())

  server NginxServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp(sort: Desc)], name: "idx_nginx_logs_server_timestamp")
  @@index([statusCode], name: "idx_nginx_logs_status")
  @@index([timestamp(sort: Desc)], name: "idx_nginx_logs_timestamp")
  @@map("nginx_logs")
}

model NginxSslCert {
  id          Int       @id @default(autoincrement())
  serverId    Int?      @map("server_id")
  domain      String    @unique @db.VarChar(255)
  certPath    String?   @map("cert_path") @db.VarChar(500)
  keyPath     String?   @map("key_path") @db.VarChar(500)
  issuer      String    @default("Unknown") @db.VarChar(100)
  expiresAt   DateTime? @map("expires_at")
  autoRenew   Boolean   @default(true) @map("auto_renew")
  lastRenewed DateTime? @map("last_renewed")
  nextRenewal DateTime? @map("next_renewal")
  status      String    @default("unknown") @db.VarChar(50)
  fingerprint String?   @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")

  server NginxServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([domain], name: "idx_nginx_ssl_certs_domain")
  @@index([expiresAt], name: "idx_nginx_ssl_certs_expires")
  @@map("nginx_ssl_certs")
}

model SmtpConfig {
  id                   Int      @id @default(autoincrement())
  name                 String   @db.VarChar(120)
  provider             String   @default("smtp_custom") @db.VarChar(30)
  host                 String   @db.VarChar(255)
  port                 Int      @default(587)
  secure               Boolean  @default(false)
  username             String?  @db.VarChar(255)
  password             String?  @db.VarChar(255)
  fromName             String?  @map("from_name") @db.VarChar(120)
  fromEmail            String   @map("from_email") @db.VarChar(255)
  replyTo              String?  @map("reply_to") @db.VarChar(255)
  tlsRejectUnauthorized Boolean @default(true) @map("tls_reject_unauthorized")
  tlsCaText            String?  @map("tls_ca_text") @db.Text
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("smtp_configs")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  subject   String   @db.VarChar(255)
  preheader String?  @db.VarChar(255)
  design    Json?    @default("null")
  html      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model ApiGatewayRoute {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  method    String   @db.VarChar(10)
  path      String   @db.VarChar(255)
  type      String   @db.VarChar(30)
  bodyType  String   @default("json") @map("body_type") @db.VarChar(20)
  headers   Json     @default("{}")
  formBody  Json?    @map("form_body")
  targetUrl String?  @map("target_url") @db.VarChar(500)
  targetHost String? @map("target_host") @db.VarChar(255)
  targetPort Int?    @map("target_port")
  targetPath String? @map("target_path") @db.VarChar(255)
  dbHost    String?  @map("db_host") @db.VarChar(255)
  dbPort    Int?     @map("db_port")
  dbName    String?  @map("db_name") @db.VarChar(255)
  dbUser    String?  @map("db_user") @db.VarChar(255)
  dbPassword String? @map("db_password") @db.VarChar(255)
  dbSsl     Boolean  @default(false) @map("db_ssl")
  sqlQuery  String?  @map("sql_query") @db.Text
  tlsEnabled Boolean @default(false) @map("tls_enabled")
  tlsCert   String?  @map("tls_cert") @db.Text
  tlsKey    String?  @map("tls_key") @db.Text
  tlsCa     String?  @map("tls_ca") @db.Text
  tlsRejectUnauthorized Boolean @default(true) @map("tls_reject_unauthorized")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([method, path], name: "idx_gateway_method_path")
  @@map("api_gateway_routes")
}

model DatabaseConnection {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  type      String   @db.VarChar(20) // postgres | mysql | mongodb
  host      String   @db.VarChar(255)
  port      Int
  user      String   @db.VarChar(255)
  password  String   @db.Text // encrypted
  database  String   @db.VarChar(255)
  projects Json     @default("[]") // [{id, name, type: 'backend'|'frontend'}]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("database_connections")
}

// ==================== WORKSPACES ====================

model Workspace {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  companies Company[]
  invites   WorkspaceInvite[]

  @@map("workspaces")
}

model Company {
  id          String    @id @default(uuid())
  name        String
  slug        String
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  projects    Project[]
  childPanel  ChildPanel?

  @@unique([workspaceId, slug])
  @@map("companies")
}

model Project {
  id        String   @id @default(uuid())
  name      String
  slug      String
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  gitUrl    String?
  gitBranch String   @default("main") @map("git_branch")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, slug])
  @@map("projects")
}

model WorkspaceInvite {
  id          String    @id @default(uuid())
  token       String    @unique
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId   String    @map("company_id")
  usedAt      DateTime? @map("used_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("workspace_invites")
}

model ChildPanel {
  id        String    @id @default(uuid())
  name      String
  url       String
  companyId String    @unique @map("company_id")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apiKey    String    @map("api_key")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("child_panels")
}

// ==================== AI CHAT (Assistant principal) ====================

model AiConversation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clienteId     String?  @map("cliente_id") // escopo multi-cliente (null = painel local)
  title         String   @default("Nova conversa")
  agent         String   @default("auto") // 'auto' ou um dos harness IDs
  summary       String?  @db.Text // resumo acumulado do contexto antigo
  summaryTokens Int      @default(0) @map("summary_tokens")
  metadata      Json     @default("{}")
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  messages AiMessage[]

  @@index([userId, updatedAt(sort: Desc)], name: "idx_ai_conv_user")
  @@index([clienteId], name: "idx_ai_conv_cliente")
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String   // 'user' | 'assistant' | 'system' | 'tool'
  content        String?  @db.Text
  blocks         Json?    // blocos interativos (generative UI) — Fase 3
  tokens         Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt], name: "idx_ai_msg_conv")
  @@map("ai_messages")
}

model AiUserProfile {
  userId     String   @id @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillLevel String   @default("auto") @map("skill_level") // auto|iniciante|intermediario|avancado
  signals    Json     @default("{}") // métricas silenciosas p/ inferência
  summary    String?  @db.Text // resumo do perfil (preferências/estilo)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("ai_user_profiles")
}

model AiUpload {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  filename       String
  mime           String?
  sizeBytes      Int      @default(0) @map("size_bytes")
  kind           String   @default("other") // zip | pdf | image | text | other
  intent         String   @default("auto") // auto|create_service|documentation|training|analyze_logs|inspect|store|publish_site
  status         String   @default("received") // received|analyzing|awaiting_user|done|error
  tmpPath        String?  @map("tmp_path")     // caminho temporário do arquivo recebido
  storagePath    String?  @map("storage_path") // destino final, se salvo
  analysis       Json?    // { summary, detection, suggestion, ... }
  decision       Json?    // { action, target, ... }
  error          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)], name: "idx_ai_upload_user")
  @@index([conversationId], name: "idx_ai_upload_conv")
  @@map("ai_uploads")
}

// ==================== ZEUS BUILDER (agente arquiteto → dev) ====================
// Multi-tenant: `clienteId` escopa por cliente (null = painel local), `userId` o dono.
// Todo estado vive aqui (stateless no processo) para permitir múltiplas instâncias do
// gateway atrás de um LB. Ver docs/PLANO-AGENTE-ARQUITETO.md e CONTEXTO-SESSAO-ZEUS-BUILDER.md.

// Projeto do Builder: unidade de trabalho (um app novo ou um sistema existente trazido via git).
model AgentProject {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId    String?  @map("cliente_id")            // escopo multi-cliente (null = painel local)
  userId       String   @map("user_id") @db.Uuid       // dono
  name         String
  kind         String   @default("new")                // new | existing
  gitUrl       String?  @map("git_url")                // repo do sistema existente, se houver
  gitBranch    String?  @map("git_branch")
  hosting      String?  @db.Text                        // onde está hospedado (texto livre do dev)
  status       String   @default("discovery")           // discovery|studying|architecture|planning|awaiting_approval|approved|building|provisioned|done|error|cancelled
  metadata     Json     @default("{}")                  // stack detectada, achados de auditoria, etc.
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions   AgentSession[]
  plans      AgentPlan[]
  specs      AgentSpec[]
  wireframes AgentWireframe[]
  buildRuns  AgentBuildRun[]

  @@index([clienteId, userId, updatedAt(sort: Desc)], name: "idx_agent_project_scope")
  @@map("agent_projects")
}

// Sessão de conversa/pipeline. Guarda o estágio (state machine) e é retomável.
model AgentSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  project      AgentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clienteId    String?  @map("cliente_id")
  userId       String   @map("user_id") @db.Uuid
  channel      String   @default("panel")               // panel | cli
  stage        String   @default("discovery")            // estágio atual da state machine
  activePlanId String?  @map("active_plan_id") @db.Uuid  // ponteiro p/ plano corrente
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  events AgentSessionEvent[]

  @@index([projectId, updatedAt(sort: Desc)], name: "idx_agent_session_project")
  @@index([clienteId, userId], name: "idx_agent_session_scope")
  @@map("agent_sessions")
}

// Log append-only da sessão (mensagens, decisões, transições). Fonte da verdade p/ retomar.
model AgentSessionEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  session    AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String                                       // user | assistant | system | tool | stage
  agent      String?                                      // persona que gerou (arquiteto, planejador, dev...)
  content    String?  @db.Text
  data       Json?                                        // payloads estruturados (plano, tool result, etc.)
  tokensIn   Int      @default(0) @map("tokens_in")
  tokensOut  Int      @default(0) @map("tokens_out")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt], name: "idx_agent_event_session")
  @@map("agent_session_events")
}

// Plano versionado (atualizável). Cada mudança relevante cria nova versão; histórico preservado.
model AgentPlan {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  project    AgentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    Int      @default(1)
  title      String
  summary    String?  @db.Text
  content    Json     @default("{}")                      // plano estruturado (titulo, tasks, riscos, custo...)
  status     String   @default("draft")                   // draft | proposed | approved | superseded
  approvedAt DateTime? @map("approved_at")
  approvedBy String?  @map("approved_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tasks AgentTask[]

  @@unique([projectId, version], name: "uq_agent_plan_version")
  @@index([projectId, createdAt(sort: Desc)], name: "idx_agent_plan_project")
  @@map("agent_plans")
}

// Especificação técnica gerada (documento) — também versionável.
model AgentSpec {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  project    AgentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    Int      @default(1)
  title      String
  content    String   @db.Text                            // markdown da spec
  data       Json     @default("{}")                      // requisitos estruturados, contratos de API
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([projectId, version], name: "uq_agent_spec_version")
  @@map("agent_specs")
}

// Wireframe/mockup gerado (imagem via Bedrock) — com prompt e feedback do usuário.
model AgentWireframe {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  project    AgentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    Int      @default(1)
  prompt     String   @db.Text                            // prompt usado p/ gerar
  imagePath  String?  @map("image_path")                  // caminho/URL da imagem gerada
  status     String   @default("generated")               // generated | approved | rejected
  feedback   String?  @db.Text                            // pedido de alteração do usuário
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([projectId, version], name: "idx_agent_wireframe_project")
  @@map("agent_wireframes")
}

// Execução do build (após aprovação). Serve também como fila/lock p/ multi-instância:
// uma instância "reivindica" um run com UPDATE ... WHERE status='queued'.
model AgentBuildRun {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  project       AgentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planId        String   @map("plan_id") @db.Uuid
  clienteId     String?  @map("cliente_id")
  userId        String   @map("user_id") @db.Uuid
  status        String   @default("queued")               // queued|running|succeeded|failed|cancelled
  claimedBy     String?  @map("claimed_by")               // id/host da instância que pegou o job
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  devStackUrl   String?  @map("dev_stack_url")            // link no domínio gerado
  tokensIn      Int      @default(0) @map("tokens_in")
  tokensOut     Int      @default(0) @map("tokens_out")
  costUsd       Decimal  @default(0) @map("cost_usd") @db.Decimal(10, 4)
  error         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tasks AgentTask[]

  @@index([status, createdAt], name: "idx_agent_run_queue")
  @@index([projectId, createdAt(sort: Desc)], name: "idx_agent_run_project")
  @@map("agent_build_runs")
}

// Micro-task atômica (do planner) executada pelo Dev Executor Bedrock.
model AgentTask {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  plan        AgentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  buildRunId  String?  @map("build_run_id") @db.Uuid
  buildRun    AgentBuildRun? @relation(fields: [buildRunId], references: [id], onDelete: SetNull)
  seq         Int                                          // ordem de execução
  descricao   String
  tipo        String   @default("codigo")                 // codigo|config|comando|analise
  prompt      String   @db.Text                            // prompt autocontido ("mastigado") p/ o dev
  model       String?                                      // override de modelo, se houver
  dependsOn   Int[]    @default([]) @map("depends_on")     // seqs das tasks das quais depende
  status      String   @default("pending")                // pending|running|done|failed|skipped
  result      String?  @db.Text                            // saída do dev (código/artefato)
  tokensIn    Int      @default(0) @map("tokens_in")
  tokensOut   Int      @default(0) @map("tokens_out")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([planId, seq], name: "idx_agent_task_plan")
  @@index([buildRunId, status], name: "idx_agent_task_run")
  @@map("agent_tasks")
}
