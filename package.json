{
  "name": "provirpanel",
  "version": "1.0.0",
  "description": "Provir Cloud Panel backend",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "nodemon backend/src/server.js",
    "frontend:dev": "npm --prefix frontend run dev -- --host",
    "backend:dev": "nodemon backend/src/server.js",
    "dev:full": "concurrently -k -n backend,frontend -c cyan,magenta \"npm run backend:dev\" \"npm run frontend:dev\"",
    "pm2:start": "pm2 start backend/src/server.js --name provirpanel",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema backend/prisma/schema.prisma",
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/client-sesv2": "^3.645.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "docker-sdk": "^0.1.0",
    "dockerode": "^4.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.4.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.5",
    "node-pty": "^1.0.0",
    "nodemailer": "^8.0.4",
    "pg": "^8.11.5",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "speakeasy": "^2.0.0",
    "tar-fs": "^3.0.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^5.22.0"
  }
}
