[
  {
    "id": "mern-stack",
    "name": "MERN Stack",
    "description": "MongoDB + Express/Node.js + Nginx reverso. Ideal para SPAs React com API REST.",
    "category": "web",
    "tags": ["javascript", "mongodb", "node", "api", "spa"],
    "complexity": "medium",
    "services": [
      {
        "id": "mern-nginx",
        "name": "nginx",
        "role": "entry-point",
        "image": "nginx",
        "tag": "1.25-alpine",
        "ports": [{ "host": 80, "container": 80 }, { "host": 443, "container": 443 }],
        "volumes": [
          { "host": "./nginx/conf.d", "container": "/etc/nginx/conf.d" },
          { "host": "./frontend/dist", "container": "/usr/share/nginx/html" }
        ],
        "env": [],
        "command": [],
        "dependencies": ["mern-api"]
      },
      {
        "id": "mern-api",
        "name": "api",
        "role": "runtime",
        "image": "node",
        "tag": "20-alpine",
        "ports": [{ "host": 3000, "container": 3000 }],
        "volumes": [{ "host": "./backend", "container": "/app" }],
        "env": [
          { "key": "NODE_ENV", "value": "production", "secret": false },
          { "key": "PORT", "value": "3000", "secret": false },
          { "key": "MONGODB_URI", "value": "mongodb://mongo:27017/app", "secret": false },
          { "key": "JWT_SECRET", "value": "", "secret": true }
        ],
        "command": ["node", "server.js"],
        "dependencies": ["mern-mongo"]
      },
      {
        "id": "mern-mongo",
        "name": "mongo",
        "role": "database",
        "image": "mongo",
        "tag": "7",
        "ports": [{ "host": 27017, "container": 27017 }],
        "volumes": [{ "host": "mongo-data", "container": "/data/db" }],
        "env": [
          { "key": "MONGO_INITDB_ROOT_USERNAME", "value": "admin", "secret": false },
          { "key": "MONGO_INITDB_ROOT_PASSWORD", "value": "", "secret": true },
          { "key": "MONGO_INITDB_DATABASE", "value": "app", "secret": false }
        ],
        "command": [],
        "dependencies": []
      }
    ]
  },
  {
    "id": "laravel-mysql-redis",
    "name": "Laravel + MySQL + Redis",
    "description": "Stack PHP completa com Laravel, MySQL para dados relacionais e Redis para cache/filas.",
    "category": "web",
    "tags": ["php", "laravel", "mysql", "redis", "queue"],
    "complexity": "medium",
    "services": [
      {
        "id": "laravel-nginx",
        "name": "nginx",
        "role": "entry-point",
        "image": "nginx",
        "tag": "1.25-alpine",
        "ports": [{ "host": 80, "container": 80 }],
        "volumes": [
          { "host": "./nginx/default.conf", "container": "/etc/nginx/conf.d/default.conf" },
          { "host": "./app", "container": "/var/www" }
        ],
        "env": [],
        "command": [],
        "dependencies": ["laravel-app"]
      },
      {
        "id": "laravel-app",
        "name": "app",
        "role": "runtime",
        "image": "php",
        "tag": "8.3-fpm-alpine",
        "ports": [{ "host": 9000, "container": 9000 }],
        "volumes": [{ "host": "./app", "container": "/var/www" }],
        "env": [
          { "key": "APP_ENV", "value": "production", "secret": false },
          { "key": "APP_DEBUG", "value": "false", "secret": false },
          { "key": "APP_KEY", "value": "", "secret": true },
          { "key": "DB_HOST", "value": "mysql", "secret": false },
          { "key": "DB_DATABASE", "value": "laravel", "secret": false },
          { "key": "DB_USERNAME", "value": "laravel", "secret": false },
          { "key": "DB_PASSWORD", "value": "", "secret": true },
          { "key": "REDIS_HOST", "value": "redis", "secret": false },
          { "key": "CACHE_DRIVER", "value": "redis", "secret": false },
          { "key": "QUEUE_CONNECTION", "value": "redis", "secret": false }
        ],
        "command": [],
        "dependencies": ["laravel-mysql", "laravel-redis"]
      },
      {
        "id": "laravel-worker",
        "name": "queue-worker",
        "role": "queue",
        "image": "php",
        "tag": "8.3-fpm-alpine",
        "ports": [],
        "volumes": [{ "host": "./app", "container": "/var/www" }],
        "env": [
          { "key": "APP_ENV", "value": "production", "secret": false },
          { "key": "DB_HOST", "value": "mysql", "secret": false },
          { "key": "REDIS_HOST", "value": "redis", "secret": false }
        ],
        "command": ["php", "artisan", "queue:work", "--sleep=3", "--tries=3"],
        "dependencies": ["laravel-app", "laravel-redis"]
      },
      {
        "id": "laravel-mysql",
        "name": "mysql",
        "role": "database",
        "image": "mysql",
        "tag": "8.0",
        "ports": [{ "host": 3306, "container": 3306 }],
        "volumes": [{ "host": "mysql-data", "container": "/var/lib/mysql" }],
        "env": [
          { "key": "MYSQL_DATABASE", "value": "laravel", "secret": false },
          { "key": "MYSQL_USER", "value": "laravel", "secret": false },
          { "key": "MYSQL_PASSWORD", "value": "", "secret": true },
          { "key": "MYSQL_ROOT_PASSWORD", "value": "", "secret": true }
        ],
        "command": [],
        "dependencies": []
      },
      {
        "id": "laravel-redis",
        "name": "redis",
        "role": "cache",
        "image": "redis",
        "tag": "7-alpine",
        "ports": [{ "host": 6379, "container": 6379 }],
        "volumes": [{ "host": "redis-data", "container": "/data" }],
        "env": [],
        "command": ["redis-server", "--appendonly", "yes"],
        "dependencies": []
      }
    ]
  },
  {
