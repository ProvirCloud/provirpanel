  {
    "id": "microservices-starter",
    "name": "Microservices Starter",
    "description": "Arquitetura de microsserviços com API Gateway Nginx, dois serviços Node.js independentes, PostgreSQL compartilhado e Redis.",
    "category": "architecture",
    "tags": ["microservices", "node", "nginx", "postgres", "redis", "api-gateway"],
    "complexity": "advanced",
    "services": [
      {
        "id": "ms-gateway",
        "name": "gateway",
        "role": "entry-point",
        "image": "nginx",
        "tag": "1.25-alpine",
        "ports": [{ "host": 80, "container": 80 }, { "host": 443, "container": 443 }],
