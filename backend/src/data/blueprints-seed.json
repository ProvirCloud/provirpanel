        "env": [],
        "command": [],
        "dependencies": ["ms-auth", "ms-api"]
      },
      {
        "id": "ms-auth",
        "name": "auth-service",
        "role": "runtime",
        "image": "node",
        "tag": "20-alpine",
        "ports": [{ "host": 3001, "container": 3001 }],
        "volumes": [{ "host": "./services/auth", "container": "/app" }],
        "env": [
          { "key": "PORT", "value": "3001", "secret": false },
          { "key": "DATABASE_URL", "value": "postgresql://app:password@postgres:5432/auth", "secret": true },
          { "key": "JWT_SECRET", "value": "", "secret": true },
          { "key": "JWT_EXPIRY", "value": "7d", "secret": false }
        ],
        "command": ["node", "server.js"],
        "dependencies": ["ms-postgres", "ms-redis"]
      },
      {
        "id": "ms-api",
        "name": "api-service",
        "role": "runtime",
        "image": "node",
        "tag": "20-alpine",
        "ports": [{ "host": 3002, "container": 3002 }],
        "volumes": [{ "host": "./services/api", "container": "/app" }],
        "env": [
          { "key": "PORT", "value": "3002", "secret": false },
          { "key": "DATABASE_URL", "value": "postgresql://app:password@postgres:5432/app", "secret": true },
          { "key": "REDIS_URL", "value": "redis://redis:6379", "secret": false },
          { "key": "AUTH_SERVICE_URL", "value": "http://auth-service:3001", "secret": false }
        ],
        "command": ["node", "server.js"],
        "dependencies": ["ms-postgres", "ms-redis", "ms-auth"]
      },
      {
        "id": "ms-postgres",
        "name": "postgres",
        "role": "database",
        "image": "postgres",
        "tag": "16-alpine",
        "ports": [{ "host": 5435, "container": 5432 }],
        "volumes": [{ "host": "ms-pg-data", "container": "/var/lib/postgresql/data" }],
        "env": [
          { "key": "POSTGRES_DB", "value": "app", "secret": false },
          { "key": "POSTGRES_USER", "value": "app", "secret": false },
          { "key": "POSTGRES_PASSWORD", "value": "", "secret": true }
